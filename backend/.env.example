# Postgres connection. postgres:// and postgresql:// URLs (Neon, Render) are accepted as-is.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/engagement
# Used only by pytest; the database name must end in _test.
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/engagement_test
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
ACCESS_TOKEN_MINUTES=480
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000
BUSINESS_TIMEZONE=Asia/Kolkata
LOG_LEVEL=INFO
